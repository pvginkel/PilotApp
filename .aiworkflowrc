# What the dev pipeline reads about this project.
# Schema: ${CLAUDE_PLUGIN_ROOT}/docs/project-contract.md

spec_repo = "../PilotAppSpecs"
design_philosophy = "docs/change-discipline.md"

[test_phase]
# The suites, the dev stack running in this environment, then the push, the
# rollout of pilot-dev and the checks against it, signed in as the test account.
strategy = "docs/slice-test-plan.md"

[doc_phase]
plan = "docs/slice-doc-plan.md"

[push]
# A slice's test phase pushes what the slice committed, which deploys it to
# pilot-dev at pilot-dev.home; production moves only when the operator promotes
# it. The driver checks that every repo reached origin.
enabled = true

# The occupancy lease over pilot-dev, held by the driver for the test phase and
# again for the doc phase's push. Relative to the spec repo, the mount every
# environment of the project shares; its git ignores the lease and the
# dev-holder note the driver writes beside it.
[devlock]
lease = "slices/.devlock.lock"
